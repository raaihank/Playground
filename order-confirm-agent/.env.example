# ─────────────────────────────────────────────────────────────────────────────
# Every key this app needs, and where to get it.
# Copy to .env.local (in this folder) or set them in the repo-root .env.
# Nothing runs without these — the app fails loudly on a missing key.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic — the agent's brain (tool use + reasoning).
# Get one at: https://console.anthropic.com/settings/keys
# NOTE: the standard name is ANTHROPIC_API_KEY. This app ALSO accepts the
# misspelled ANTROPIC_API_KEY that already exists in the repo-root .env.
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs — real speech-to-text (Scribe) and text-to-speech.
# Get one at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=...
